# Copy to .env and adjust as needed. Never commit the real .env file.

ENVIRONMENT=development
SERVICE_NAME=web-data-platform-api

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible object storage, local dev only) ---
# Not consumed by any application code yet — object storage
# integration starts Phase 8. Present here so the docker-compose
# MinIO service has matching credentials from day one.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=platform
MINIO_SECRET_KEY=platform123
MINIO_BUCKET=web-data-platform

LOG_LEVEL=INFO
